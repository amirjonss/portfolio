# Cloudflare Web Analytics: Cloudflare → Analytics → Web Analytics → add site,
# затем скопировать token из выданного сниппета.
# Пока пусто — скрипт аналитики не подключается вовсе.
NUXT_PUBLIC_CF_BEACON_TOKEN=

# Стабильная подпись для OG-картинок (иначе меняется при каждой сборке).
# Сгенерировать: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=
